# ============================================================
# .env.example —— 复制为 .env 后填入真实值
#
# ⚠️ .env 必须进 .gitignore，绝不提交（N-15；PRD §11.5 有真实事故）
# ⚠️ 本文件只放键名与说明，绝不放真实密钥
# ⚠️ 配置项与 deploy/docker-compose.yml、backend/app/core/config.py **三方必须一一对应**：
#    新增配置项要同步 07 附录 6，否则新机器部署会缺项且启动即失败（这是刻意的）。
#    本文件比 docs/05 附录 D §D.4.1 多出 07 附-6 新增项（已分组标注）。
#
# ★★★ 行尾注释规则（踩过的真坑，务必遵守）★★★
# python-dotenv 只在**值非空**时才剥离 ` # 注释`：
#     A=                → ''            ✅ 正常
#     B=value  # cmt    → 'value'       ✅ 注释被剥离
#     C=  # only cmt    → '# only cmt'  ❌ **注释变成了值**
# 因此：**值留空的行不得写行尾注释**，注释一律写在上一行。
# 本文件曾因此让 5 个键静默拿到垃圾值 —— 其中 4 个是 τ 校准三元组，
# 后果是 `binding_tau_is_calibrated` 恒为 True（N-27 的 prod 门禁形同虚设，
# 且 U-19 要求的那条启动 WARN 永远不会打）。
# `backend/app/core/config.py` 已加"值以 # 开头即拒绝启动"的兜底，
# 契约测试 `test_env_example_values_are_not_comment_leaks` 会守住这条规则。
# ============================================================

# ---------- 应用 ----------
APP_ENV=dev                      # dev | staging | prod（prod 时 CORS_ALLOWED_ORIGINS 必须为空）
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_PORT=8000
TIMEZONE=Asia/Shanghai
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- LLM（DeepSeek） ----------
# 必填。只在此处填，严禁硬编码。
# ⚠️ 值留空的行**不得**再写行尾注释 —— 见本文件顶部"行尾注释规则"。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-flash    # 意图分类/归一化/简单SQL生成
LLM_MODEL_STRONG=deepseek-v4-pro # L3+ 复杂查询
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=50           # ⚠️ 上游限的是**并发连接数**，不是 QPS（07 §10.1）
LLM_MAX_RETRIES=3
LLM_SEMAPHORE_FLASH=8            # ★ 07 附-6：按模型并发信号量（多进程需改 Redis 令牌桶）
LLM_SEMAPHORE_PRO=2              # ★ 07 附-6
LLM_CIRCUIT_FAILS=5              # ★ 07 附-6：熔断失败阈值
LLM_CIRCUIT_OPEN_S=30            # ★ 07 附-6：熔断开启时长

# ---------- 数据库（⚠️ 双 DSN，两条独立连接，代码不得混用） ----------
# 1) 元数据库：读写。承载 session / query_task / audit_log / cost_ledger / eval_* / checkpointer
#    角色 app_rw；对 audit_log **仅 INSERT**（append-only，ADR-14）
DATABASE_URL=postgresql+psycopg://app_rw:app_rw_pwd@pg:5432/ecom

# 2) 分析库：只读。业务 SQL 的**唯一出口**，角色 app_ro
#    （default_transaction_read_only=on + 无写权限 + RLS 生效）
#    ⚠️ P0 与 DATABASE_URL 指向**同一实例**（角色级强制，非物理副本）；
#       升级为真实只读副本时只改本行 → 配置级改动
#    ⚠️ 两条 DSN **不得相同**，否则只读保证当场失效（启动即拒绝）
ANALYTICS_DB_URL=postgresql+psycopg://app_ro:app_ro_pwd@pg:5432/ecom

SQLITE_SANDBOX_PATH=/data/sandbox/ecom_sandbox.db

# ---------- Embedding（Ollama，运行在宿主） ----------
# ⚠️ 后端【本地运行】用 127.0.0.1；后端【容器化】必须用 host.docker.internal
#    （容器写 127.0.0.1 必然连不上 —— 容器有自己的 loopback）
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3            # 1024 维；需 ollama pull bge-m3（约 1.2GB，一次性）
EMBEDDING_DIM=1024                # 必须参与向量索引 DDL → 换模型 = 版本递增 + 重建索引，不改代码
EMBEDDING_TIMEOUT_SECONDS=30      # 需覆盖"未预热"时的模型加载延迟
EMBEDDING_REQUIRED=false          # false = 不可用时走降级（稀疏 + 图扩展 + 值检索）并在 meta 显式标注

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600
SESSION_TTL_SECONDS=86400

# ---------- 认证 ----------
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ISSUER=workbuddy-demo
JWT_AUDIENCE=text2sql-agent

# ---------- 语义层 ----------
SEMANTIC_BUNDLE_PATH=/semantic/bundle_2026.09.14.1.yaml
SEMANTIC_REQUIRE_CERTIFIED=true

# ---------- 执行与安全 ----------
EXEC_STATEMENT_TIMEOUT_MS=30000
EXEC_MAX_ROWS=10000
EXEC_MAX_MEMORY_MB=512            # 超限 → EXEC_RESOURCE_EXCEEDED(422)，与 COST_TOO_HIGH 是两个码
EXEC_COST_ROW_THRESHOLD=1000000   # EXPLAIN 预估行数闸门
GATE_REJECT_SELECT_STAR=true
GATE_MAX_REPAIR_ROUNDS=2

# ---------- 闸门三阈值（★ 07 附-6；要求 WARN < REJECT，否则启动即拒绝） ----------
GATE3_COST_WARN=50000
GATE3_COST_REJECT=500000
GATE3_ROWS_WARN=500000
GATE3_ROWS_REJECT=5000000

# ---------- 检索与融合（★ 07 附-6；四项权重之和必须 = 1.0） ----------
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40
FTS_RANK_NORMALIZATION=32
FTS_SCORE_MIN=0.05
RRF_K=60
DENSE_WEIGHT=0.40
SPARSE_WEIGHT=0.35
VALUE_WEIGHT=0.15
GRAPH_WEIGHT=0.10

# ---------- 绑定 L4 打分器（★ 07 附-6；N-27 要求 τ 必须绑定版本 + 校准时间） ----------
BINDING_TAU=0.20                  # ⚠️ 待校准：未经冻结集校准**不得上线**（N-25）
BINDING_TAU_EPSILON=0.05          # τ 邻域宽度 → 落入即判 ambiguous（失败侧偏安全）
# ★ 必填：τ 绑定 (model_id, prompt_version)。**留空即"未校准"**（非 prod 放行但打 WARN）。
BINDING_TAU_MODEL_ID=
# ★ 必填
BINDING_TAU_PROMPT_VERSION=
# ★ 必填：ISO8601；空 = 未校准，启动拒绝（防"调 τ 降澄清率"）
BINDING_TAU_CALIBRATED_AT=
# 校准报告引用（N-25：τ 每次变更必须附报告）
BINDING_TAU_REPORT_REF=

# ---------- 并发、幂等与预算 ----------
SESSION_LOCK_TTL_S=60
SESSION_LOCK_WAIT_MS=3000         # 超时 → 409 SESSION_CONFLICT + Retry-After: 3（不是 429）
REPLAY_EVENT_LIMIT=200
CHECKPOINT_TTL_DAYS=7
DAILY_BUDGET_CNY=100
BUDGET_ALERT_RATIO=0.8

# ---------- 开关（默认关闭的，开启必须二次确认） ----------
ENABLE_RESULT_CACHE=false
ENABLE_RESULT_CACHE_CONFIRMED=false  # ADR-12 防误开：结果缓存 P0 关闭，键设计错 = 事故
