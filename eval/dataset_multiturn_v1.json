  "policy": "B6 新增件。只做多轮条件继承的期望集，不改 dataset_v1_frozen / dataset_v2_frozen / gold_query_seed_v1。所有 turn 的 expected_behavior 均为 execute；澄清/拒答仍由主冻结集覆盖。",
  "schema": {
    "case_id": "mtNN",
    "follow_up_type": "ellipsis_time | metric_switch | dimension_add | filter_change | pronoun | grain_change | limit | reset",
    "turns[].question": "用户原话",
    "turns[].expect": "该轮应解析出的指标/维度/时间/筛选（`null` = 该轮不应有该条件）",
    "note": "为什么这条能验证条件继承"
  },
  "n_cases": 15,
  "content_hash": "sha256:d4a7a755b4768600a7ff30541803cfee53236cf096c1048ffb662d99e7d32dec",
  "cases": [
    {
      "case_id": "mt01",
      "follow_up_type": "ellipsis_time",
      "turns": [
        {
          "question": "2018 年 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        },
        {
          "question": "那 2017 年呢？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "time_start": "2017-01-01", "time_end": "2018-01-01"}
        }
      ],
      "note": "第二轮只换了时间：指标/资产必须沿用第一轮，时间以本轮显式表达为准。"
    },
    {
      "case_id": "mt02",
      "follow_up_type": "metric_switch",
      "turns": [
        {
          "question": "2018 年 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        },
        {
          "question": "换成订单量呢？",
          "expect": {"metrics": ["order_cnt"], "dimensions": [], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        }
      ],
      "note": "只换指标：时间窗必须从上一轮继承（本轮问句没有时间词）。"
    },
    {
      "case_id": "mt03",
      "follow_up_type": "dimension_add",
      "turns": [
        {
          "question": "2018 年 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        },
        {
          "question": "按州拆开看看",
          "expect": {"metrics": ["gmv"], "dimensions": ["customer_state"], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        }
      ],
      "note": "省略主语的追问：指标与时间沿用，新增一个维度。"
    },
    {
      "case_id": "mt04",
      "follow_up_type": "filter_change",
      "turns": [
        {
          "question": "2018 年圣保罗州的 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "filters": ["customer_state = 'SP'"], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        },
        {
          "question": "那里约州呢？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "filters": ["customer_state = 'RJ'"], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        }
      ],
      "note": "指代 + 换筛选值：指标与时间必须继承，筛选值以本轮为准（不得同时保留 SP 与 RJ）。"
    },
    {
      "case_id": "mt05",
      "follow_up_type": "pronoun",
      "turns": [
        {
          "question": "2018 年 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "time_start": "2018-01-01", "time_end": "2019-01-01"}
        },
        {
          "question": "它比 2017 年高多少？",
          "expect": {"metrics": ["gmv"], "dimensions": [], "time_start": "2018-01-01", "time_end": "2019-01-01", "comparison": "2017"}
        }
      ],
      "note": "「它」指上一轮指标；比较基准 2017 是本轮新增条件，不得把主时间窗改成 2017。"
    },
    {
      "case_id": "mt06",
      "follow_up_type": "metric_add",
      "turns": [
        {
          "question": "2018 年各月 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": ["date"], "grain": "month", "time_start": "2018-01-01", "time_end": "2019-01-01"}
