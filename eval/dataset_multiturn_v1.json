        },
        {
          "question": "只看前 5 名",
          "expect": {"metrics": ["gmv"], "dimensions": ["customer_state"], "time_start": "2018-01-01", "time_end": "2019-01-01", "limit": 5, "order_by": ["gmv desc"]}
        }
      ],
      "note": "只加上限/排序：指标、维度、时间都必须继承。"
    },
    {
      "case_id": "mt09",
      "follow_up_type": "grain_change",
      "turns": [
        {
          "question": "2018 年各月 GMV 是多少？",
          "expect": {"metrics": ["gmv"], "dimensions": ["date"], "grain": "month", "time_start": "2018-01-01", "time_end": "2019-01-01"}
