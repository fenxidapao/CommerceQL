      "sql_text": "WITH bounds AS (\n  SELECT %(cur_start)s::date AS cur_start,\n         %(cur_end)s::date AS cur_end,\n         %(prev_start)s::date AS prev_start,\n         %(prev_end)s::date AS prev_end\n),\ncur AS (\n  SELECT SUM(v_order_paid.pay_amount) AS gmv\n  FROM v_order_paid, bounds\n  WHERE v_order_paid.pay_status = 'paid'\n    AND v_order_paid.refund_status <> 'refunded'\n    AND v_order_paid.is_test_order = false\n    AND v_order_paid.pay_time >= bounds.cur_start\n    AND v_order_paid.pay_time < (bounds.cur_end + INTERVAL '1 day')\n),\nprev AS (\n  SELECT SUM(v_order_paid.pay_amount) AS gmv\n  FROM v_order_paid, bounds\n  WHERE v_order_paid.pay_status = 'paid'\n    AND v_order_paid.refund_status <> 'refunded'\n    AND v_order_paid.is_test_order = false\n    AND v_order_paid.pay_time >= bounds.prev_start\n    AND v_order_paid.pay_time < (bounds.prev_end + INTERVAL '1 day')\n)\nSELECT 'current_7d' AS period,\n       cur.gmv AS gmv,\n       prev.gmv AS gmv_prev_period,\n       (cur.gmv - prev.gmv) / NULLIF(prev.gmv, 0) AS gmv_mom_ratio\nFROM cur, prev\nLIMIT 10",
