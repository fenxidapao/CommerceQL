      "sql_text": "WITH buyer_cnt AS (SELECT v_order_paid.buyer_id AS buyer_id, COUNT(DISTINCT v_order_paid.sub_order_id) AS cnt FROM v_order_paid WHERE v_order_paid.pay_status = %(pay_status)s AND v_order_paid.is_test_order = FALSE AND v_order_paid.pay_status = 'paid' AND v_order_paid.is_test_order = FALSE GROUP BY v_order_paid.buyer_id) SELECT COUNT(DISTINCT CASE WHEN buyer_cnt.cnt >= 2 THEN buyer_cnt.buyer_id END) * 1.0 / NULLIF(COUNT(DISTINCT buyer_cnt.buyer_id), 0) AS repurchase_rate_90d FROM buyer_cnt LIMIT 10000",
