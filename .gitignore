# ============================================================================
# .gitignore —— 归属窗口：W0（清单外新增，理由见交付说明 Q-12）
#
# ⚠️ 为什么阶段 0 必须建它（不是"顺手加的"）：
#   N-15 与阶段 0 DoD④（gitleaks 无命中）都建立在"密钥不进仓库"之上。
#   没有 .gitignore，一次 `git add -A` 就会把 `.env` 提交上去 ——
#   PRD §11.5 记录的就是这类真实事故。
# ============================================================================

# ---------- 密钥与环境（最高优先级） ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# ---------- 测试与覆盖率 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ---------- 工具临时产物 ----------
# import-linter 语义探测的临时目录（用完即删）
.lintprobe/
# import-linter 的图缓存：与源码强相关，绝不进仓库
.import_linter_cache/
# DoD② 注入实验的残留（正常应由 scripts/assert_importlinter.py 自清理；
# 这里兜底，防异常中断时把探针文件提交上去）
**/_probe_violation.py
*.log
logs/

# ---------- 数据与体积物 ----------
# ⚠️ Docker 数据已迁到 E 盘（附录 D §D.1.3.1），卷不会落进仓库；这里只防误拷
pg_data/
*.sqlite
*.db
# 评测沙箱库若需要进仓库，用 `git add -f` 单独放行（默认仍忽略）
!ecom_sandbox.db

# ---------- 评测产物（冻结集与红队集**要**进仓库，结果不进） ----------
eval/runs/
eval/reports/local/

# ---------- 前端 ----------
node_modules/
frontend/dist/

# ---------- 编辑器与系统 ----------
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
